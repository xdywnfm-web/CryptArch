<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CryptArch V2 Beta" Width="1250" Height="800" MinWidth="1000" MinHeight="590"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#0D111D"
        FontFamily="Segoe UI" FontSize="14" TextOptions.TextFormattingMode="Display">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="55" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#F3F4FC"/>
    <SolidColorBrush x:Key="Muted" Color="#B0BAD1"/>
    <SolidColorBrush x:Key="Violet" Color="#A497FF"/>
    <SolidColorBrush x:Key="Rim" Color="#343D58"/>
    <LinearGradientBrush x:Key="Primary" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#525CF2"/><GradientStop Offset="1" Color="#6123BE"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Surface" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#191E30"/><GradientStop Offset="1" Color="#131827"/>
    </LinearGradientBrush>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
    <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Title" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Rim}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="15"/><Setter Property="Padding" Value="18"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="#1F263A"/>
      <Setter Property="BorderBrush" Value="{StaticResource Rim}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,8"/><Setter Property="MinHeight" Value="42"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Frame" CornerRadius="10" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#AFA7FF"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#E2DDFF"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value=".78"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value=".46"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="MinHeight" Value="50"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Margin" Value="0,0,0,7"/>
    </Style>
    <Geometry x:Key="CaptionMinimize">M2,8 H14</Geometry>
    <Geometry x:Key="CaptionMaximize">M2,2 H14 V14 H2 Z</Geometry>
    <Geometry x:Key="CaptionRestore">M2,5 H11 V14 H2 Z M5,5 V2 H14 V11 H11</Geometry>
    <Geometry x:Key="CaptionCloseIcon">M3,3 L13,13 M13,3 L3,13</Geometry>
    <Style x:Key="Caption" TargetType="Button">
      <Setter Property="Width" Value="44"/><Setter Property="Height" Value="38"/>
      <Setter Property="Margin" Value="5,0,0,0"/>
      <Setter Property="Background" Value="#121725"/><Setter Property="BorderBrush" Value="#252D42"/>
      <Setter Property="Foreground" Value="#D7DDF1"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="CaptionFrame" CornerRadius="8" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
          <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <Path Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocused" Value="True">
            <Setter TargetName="CaptionFrame" Property="BorderBrush" Value="#C7BFFF"/>
            <Setter TargetName="CaptionFrame" Property="BorderThickness" Value="2"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#252D46"/><Setter Property="BorderBrush" Value="#455474"/>
          <Setter Property="Foreground" Value="#FFFFFF"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#323C59"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CaptionToggle" TargetType="Button" BasedOn="{StaticResource Caption}">
      <Setter Property="Content" Value="{StaticResource CaptionMaximize}"/>
      <Setter Property="ToolTip" Value="{DynamicResource MaximizeLabel}"/><Setter Property="AutomationProperties.Name" Value="{DynamicResource MaximizeLabel}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
          <Setter Property="Content" Value="{StaticResource CaptionRestore}"/>
          <Setter Property="ToolTip" Value="{DynamicResource RestoreLabel}"/>
          <Setter Property="AutomationProperties.Name" Value="{DynamicResource RestoreLabel}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource Caption}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#B62D4B"/><Setter Property="BorderBrush" Value="#E2637E"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#942339"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Padding" Value="12,8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="Item" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#343262"/></Trigger>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#454071"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Height" Value="47"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <Border x:Name="Field" CornerRadius="10" Background="#202638" BorderBrush="#47516F" BorderThickness="1"/>
          <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent">
              <Path Data="M0,0 L5,5 L10,0" Stroke="#E7E9FF" StrokeThickness="1.6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
            </Border></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter Margin="13,0,31,0" IsHitTestVisible="False" VerticalAlignment="Center"
              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
          <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                 AllowsTransparency="True" Focusable="False">
            <Border Background="#202638" BorderBrush="#626D91" BorderThickness="1" CornerRadius="7"
                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
              <ScrollViewer MaxHeight="240"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#CFCAFF"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#9386E8"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Field" Property="Opacity" Value=".45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="19"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
        <Border Background="#242C43" BorderBrush="#343F5C" BorderThickness="1" CornerRadius="9">
          <Grid x:Name="PART_Track"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{StaticResource Primary}" CornerRadius="8"/></Grid>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Geometry x:Key="Play">M3,1 L22,12 3,23 Z</Geometry>
    <Geometry x:Key="ActionPauseIcon">M5,3 H8 V15 H5 Z M10,3 H13 V15 H10 Z</Geometry>
    <Geometry x:Key="ActionResumeIcon">M5,3 L15,9 5,15 Z</Geometry>
    <Style x:Key="CompactAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="48"/><Setter Property="Height" Value="48"/>
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="8,0,0,0"/>
    </Style>
    <Geometry x:Key="Film">M2,3 H22 V21 H2 Z M7,3 V21 M17,3 V21 M2,9 H7 M2,15 H7 M17,9 H22 M17,15 H22</Geometry>
    <Geometry x:Key="Folder">M2,6 V21 H22 V8 H12 L9,4 H2 Z</Geometry>
    <Geometry x:Key="File">M5,2 H14 L20,8 V22 H5 Z M14,2 V8 H20</Geometry>
    <Geometry x:Key="Sliders">M2,5 H22 M2,12 H22 M2,19 H22 M7,2 V8 M16,9 V15 M10,16 V22</Geometry>
    <Geometry x:Key="Layers">M2,8 L12,2 22,8 12,14 Z M2,13 L12,19 22,13 M2,18 L12,24 22,18</Geometry>
    <Geometry x:Key="Info">M12,2 A10,10 0 1 1 11.99,2 Z M12,11 V17 M12,7 V8</Geometry>
    <Style x:Key="Glyph" TargetType="Path">
      <Setter Property="Width" Value="23"/><Setter Property="Height" Value="23"/>
      <Setter Property="Stroke" Value="{StaticResource Violet}"/><Setter Property="StrokeThickness" Value="1.8"/>
      <Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>
    <LinearGradientBrush x:Key="WaveFill" StartPoint="0,0" EndPoint="1,.65">
      <GradientStop Color="#00152766"/><GradientStop Offset=".32" Color="#6B1C4B98"/>
      <GradientStop Offset=".66" Color="#9E532CDC"/><GradientStop Offset="1" Color="#03382286"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WaveEdge" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#001C4198"/><GradientStop Offset=".39" Color="#FF448DFF"/>
      <GradientStop Offset=".69" Color="#FFAB79FF"/><GradientStop Offset="1" Color="#00653CF6"/>
    </LinearGradientBrush>
    <DrawingBrush x:Key="Ribbon" Stretch="Fill">
      <DrawingBrush.Drawing><DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="M0,0 H560 V170 H0 Z"/>
        <GeometryDrawing Brush="{StaticResource WaveFill}" Geometry="M0,133 C90,165 137,31 225,61 C333,99 354,157 450,44 C501,-11 547,10 560,4 L560,66 C506,59 464,116 395,145 C326,175 275,111 211,101 C128,87 96,172 0,155 Z"/>
        <GeometryDrawing Geometry="M0,133 C90,165 137,31 225,61 C333,99 354,157 450,44 C501,-11 547,10 560,4">
          <GeometryDrawing.Pen><Pen Brush="#304B4EE5" Thickness="8"/></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M0,133 C90,165 137,31 225,61 C333,99 354,157 450,44 C501,-11 547,10 560,4">
          <GeometryDrawing.Pen><Pen Brush="{StaticResource WaveEdge}" Thickness="2"/></GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup></DrawingBrush.Drawing>
    </DrawingBrush>
  </Window.Resources>
  <Grid Background="#0D111D">
    <Grid.RowDefinitions><RowDefinition Height="55"/><RowDefinition/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Background="#0B0E17">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="26,0">
        <Path Style="{StaticResource Glyph}" Data="{StaticResource Play}" Fill="#8490FF" StrokeThickness="0"/>
        <TextBlock Text="CryptArch" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
        <Border Background="#1E2437" CornerRadius="9" Padding="9,3" Margin="12,0,0,0"><TextBlock Text="v2.0 Beta" Foreground="{StaticResource Muted}" FontSize="12"/></Border>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
        <Button x:Name="Minimize" Style="{StaticResource Caption}" Content="{StaticResource CaptionMinimize}" ToolTip="{DynamicResource MinimizeLabel}" AutomationProperties.Name="{DynamicResource MinimizeLabel}"/>
        <Button x:Name="Maximize" Style="{StaticResource CaptionToggle}"/>
        <Button x:Name="CloseWindow" Style="{StaticResource CaptionClose}" Content="{StaticResource CaptionCloseIcon}" ToolTip="{DynamicResource CloseLabel}" AutomationProperties.Name="{DynamicResource CloseLabel}"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="#121726" BorderBrush="#20293E" BorderThickness="0,0,1,0">
        <Grid ClipToBounds="True">
          <Rectangle Height="160" Width="335" Margin="-88,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="{StaticResource Ribbon}" IsHitTestVisible="False"/>
          <StackPanel Margin="10,24,10,0">
            <Button x:Name="NavCompress" Style="{StaticResource Nav}" AutomationProperties.Name="{DynamicResource CompressLabel}">
              <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Glyph}" Data="{StaticResource Film}"/><TextBlock Text="{DynamicResource CompressLabel}" VerticalAlignment="Center"/></StackPanel>
            </Button>
            <Button x:Name="NavQueue" Style="{StaticResource Nav}" AutomationProperties.Name="{DynamicResource QueueLabel}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Glyph}" Data="{StaticResource Layers}"/><TextBlock Text="{DynamicResource QueueLabel}" VerticalAlignment="Center"/></StackPanel></Button>
            <Button x:Name="NavSettings" Style="{StaticResource Nav}" AutomationProperties.Name="{DynamicResource SettingsLabel}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Glyph}" Data="{StaticResource Sliders}"/><TextBlock Text="{DynamicResource SettingsLabel}" VerticalAlignment="Center"/></StackPanel></Button>
            <Button x:Name="NavAbout" Style="{StaticResource Nav}" AutomationProperties.Name="{DynamicResource AboutLabel}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Glyph}" Data="{StaticResource Info}"/><TextBlock Text="{DynamicResource AboutLabel}" VerticalAlignment="Center"/></StackPanel></Button>
          </StackPanel>
        </Grid>
      </Border>
      <ScrollViewer x:Name="Workspace" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MinHeight="{Binding ViewportHeight, ElementName=Workspace}">
          <StackPanel x:Name="HomeContent" Margin="30,28" MaxWidth="860" VerticalAlignment="Center">
            <Border Style="{StaticResource Card}" Padding="0" CornerRadius="20" Margin="0,0,0,16">
              <StackPanel>
                <Grid Margin="28,23,24,22">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <Border Width="38" Height="38" HorizontalAlignment="Left" CornerRadius="10" Background="#2B2850" BorderBrush="#4C427A" BorderThickness="1">
                      <Path Style="{StaticResource Glyph}" Data="{StaticResource Film}" Width="20" Height="20" Margin="0"/>
                    </Border>
                    <TextBlock Text="{DynamicResource SourceLabel}" FontWeight="SemiBold" FontSize="29" Margin="0,10,0,3"/>
                    <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource SourceHint}" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal">
                      <Button x:Name="ChooseFile" AutomationProperties.Name="{DynamicResource FileLabel}" Background="#292745" BorderBrush="#5D518D">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Glyph}" Data="{StaticResource File}" Width="17" Height="17" Stroke="#DED9FF" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource FileLabel}"/></StackPanel>
                      </Button>
                      <Button x:Name="ChooseFolder" AutomationProperties.Name="{DynamicResource FolderLabel}" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Glyph}" Data="{StaticResource Folder}" Width="17" Height="17" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource FolderLabel}"/></StackPanel>
                      </Button>
                    </StackPanel>
                    <Border Margin="0,10,12,0" Padding="10,7" Background="#101524" BorderBrush="#303953" BorderThickness="1" CornerRadius="7">
                      <TextBlock x:Name="SourcePath" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                    </Border>
                  </StackPanel>
                  <Viewbox Grid.Column="1" MaxWidth="285" Margin="10,0,0,0" IsHitTestVisible="False">
                    <Canvas Width="294" Height="198">
                      <Ellipse Width="294" Height="198">
                        <Ellipse.Fill><RadialGradientBrush>
                          <GradientStop Color="#684C39CB"/><GradientStop Color="#00272063" Offset="1"/>
                        </RadialGradientBrush></Ellipse.Fill>
                      </Ellipse>
                      <Rectangle Width="294" Height="118" Canvas.Top="45" Fill="{StaticResource Ribbon}"/>
                      <Border Width="112" Height="75" CornerRadius="14" Canvas.Left="92" Canvas.Top="37" Background="#222541" BorderBrush="#505780" BorderThickness="1"/>
                      <Border Width="112" Height="75" CornerRadius="14" Canvas.Left="111" Canvas.Top="51" Background="#262844" BorderBrush="#655E9C" BorderThickness="1"/>
                      <Border Width="112" Height="75" CornerRadius="14" Canvas.Left="130" Canvas.Top="65" Background="#282450" BorderBrush="#8775E0" BorderThickness="1.5">
                        <Grid>
                          <Path Data="{StaticResource Play}" Width="26" Height="26" Stretch="Uniform" Fill="#C3B7FF"/>
                          <Path Data="M0,0 H9 M0,0 V9 M22,0 H13 M22,0 V9 M0,16 H9 M0,16 V7 M22,16 H13 M22,16 V7"
                                Width="78" Height="47" Stretch="Fill" Stroke="#786CB9" StrokeThickness="1" Opacity=".6"/>
                        </Grid>
                      </Border>
                    </Canvas>
                  </Viewbox>
                </Grid>
                <Border BorderBrush="#333C56" BorderThickness="0,1,0,0" Padding="28,14" Background="#111628" CornerRadius="0,0,19,19">
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="Start" Height="48" MinWidth="245" FontSize="17" FontWeight="SemiBold" Background="{StaticResource Primary}" BorderBrush="#9E91FF" AutomationProperties.Name="{DynamicResource StartLabel}">
                      <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Glyph}" Width="15" Height="15" Data="{StaticResource Play}" Fill="White" StrokeThickness="0"/><TextBlock Text="{DynamicResource StartLabel}"/></StackPanel>
                    </Button>
                    <Button x:Name="Pause" Style="{StaticResource CompactAction}" IsEnabled="False">
                      <Path x:Name="PauseIcon" Width="18" Height="18" Fill="{StaticResource Ink}" Data="{StaticResource ActionPauseIcon}" IsHitTestVisible="False"/>
                    </Button>
                    <Button x:Name="Cancel" Style="{StaticResource CompactAction}" IsEnabled="False"
                            ToolTip="{DynamicResource CancelLabel}" AutomationProperties.Name="{DynamicResource CancelLabel}">
                      <Path Width="16" Height="16" Data="{StaticResource CaptionCloseIcon}" Stroke="{StaticResource Ink}"
                            StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"/>
                    </Button>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="28,17">
              <StackPanel>
                <DockPanel>
                  <TextBlock x:Name="Eta" DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                  <TextBlock Text="{DynamicResource ProgressLabel}" Style="{StaticResource Title}"/>
                </DockPanel>
                <TextBlock x:Name="Count" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,8"/>
                <ProgressBar x:Name="Progress" Maximum="100" AutomationProperties.Name="{DynamicResource ProgressLabel}"/>
                <TextBlock x:Name="Status" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                <Border BorderBrush="#303953" BorderThickness="0,1,0,0" Margin="0,11,0,0" Padding="0,9,0,0">
                  <TextBlock x:Name="SettingsSummary" Style="{StaticResource Hint}"/>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
      <ScrollViewer x:Name="SettingsPane" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,26,25,24">
          <TextBlock Text="{DynamicResource SettingsLabel}" FontSize="32" FontWeight="Bold" Margin="0,0,0,20"/>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
              <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Glyph}" Data="{StaticResource Sliders}"/><TextBlock Style="{StaticResource Title}" Text="{DynamicResource CompressionSettings}"/></StackPanel>
              <Grid Margin="0,11,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.24*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,15,0"><TextBlock Text="{DynamicResource QualityLabel}" Margin="0,0,0,6"/><ComboBox x:Name="Quality" AutomationProperties.Name="{DynamicResource QualityLabel}"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,15,0"><TextBlock Text="{DynamicResource CodecLabel}" Margin="0,0,0,6"/><ComboBox x:Name="Codec" AutomationProperties.Name="{DynamicResource CodecLabel}"/></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,15,0"><TextBlock Text="{DynamicResource DeviceLabel}" Margin="0,0,0,6"/><ComboBox x:Name="Device" AutomationProperties.Name="{DynamicResource DeviceLabel}"/></StackPanel>
                <StackPanel Grid.Column="3"><TextBlock Text="{DynamicResource WorkersLabel}" Margin="0,0,0,6"/><ComboBox x:Name="Workers" AutomationProperties.Name="{DynamicResource WorkersLabel}"/></StackPanel>
              </Grid>
              <TextBlock Style="{StaticResource Hint}" Margin="0,13,0,0" Text="{DynamicResource CompressionHint}"/>
            </StackPanel>
          </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
              <StackPanel>
                <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Glyph}" Data="{StaticResource Folder}"/><TextBlock Style="{StaticResource Title}" Text="{DynamicResource OutputLabel}"/></StackPanel>
                <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource OutputHint}" Margin="35,3,0,13"/>
                <Border BorderBrush="#414D6A" Background="#202638" BorderThickness="1" CornerRadius="10" Padding="9">
                  <DockPanel>
                    <Button x:Name="ResetOutput" DockPanel.Dock="Right" Content="{DynamicResource ResetOutputLabel}" Margin="8,0,0,0" IsEnabled="False"/>
                    <Button x:Name="ChooseOutput" DockPanel.Dock="Right" Content="{DynamicResource BrowseLabel}" Margin="8,0,0,0"/>
                    <TextBlock x:Name="OutputPath" Foreground="{StaticResource Muted}" Margin="4,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </DockPanel>
                </Border>
                <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource DefaultOutput}" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>
          <Border Style="{StaticResource Card}" MaxWidth="600" HorizontalAlignment="Left">
            <StackPanel>
              <TextBlock Text="{DynamicResource LanguageLabel}" Style="{StaticResource Title}"/>
              <TextBlock Text="{DynamicResource LanguageHint}" Style="{StaticResource Hint}" Margin="0,5,0,13"/>
              <ComboBox x:Name="Language" AutomationProperties.Name="{DynamicResource LanguageLabel}" Width="245" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="QueuePane" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,26,25,24" MaxWidth="860">
          <TextBlock Text="{DynamicResource QueueLabel}" FontSize="32" FontWeight="Bold" Margin="0,0,0,20"/>
          <Border Style="{StaticResource Card}" Padding="24">
            <StackPanel>
              <TextBlock x:Name="QueueEmptyText" Text="{DynamicResource QueueEmpty}" Margin="0,4" Foreground="{StaticResource Muted}" TextWrapping="Wrap">
                <TextBlock.Style><Style TargetType="TextBlock">
                  <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=QueueFiles}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger></Style.Triggers>
                </Style></TextBlock.Style>
              </TextBlock>
              <ListBox x:Name="QueueFiles" Background="#101524" Foreground="{StaticResource Ink}"
                       BorderBrush="{StaticResource Rim}" Padding="6" MaxHeight="460"
                       AutomationProperties.Name="{DynamicResource QueueLabel}">
                <ListBox.Style><Style TargetType="ListBox">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers><Trigger Property="HasItems" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </Trigger></Style.Triggers>
                </Style></ListBox.Style>
              </ListBox>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="AboutPane" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,26,25,24" MaxWidth="860">
          <TextBlock Text="{DynamicResource AboutLabel}" FontSize="32" FontWeight="Bold" Margin="0,0,0,20"/>
          <Border Style="{StaticResource Card}" Padding="24">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Path Style="{StaticResource Glyph}" Data="{StaticResource Play}" Fill="#A497FF" StrokeThickness="0"/>
                <TextBlock Text="CryptArch V2 Beta" Style="{StaticResource Title}"/>
              </StackPanel>
              <TextBlock Text="{DynamicResource AboutBody}" Style="{StaticResource Hint}" Margin="35,0,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
